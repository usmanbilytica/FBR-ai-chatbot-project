# Copy to .env and fill in real values. Never commit .env.

ENVIRONMENT=production            # development | staging | production
ALLOW_DEV_OPEN_ACCESS=0

# HRMS database (SQL Server)
HRMS_DB_SERVER=
HRMS_DB_NAME=FBR_HRMS
HRMS_DB_USER=
HRMS_DB_PASSWORD=

# Personal files / OCR database (SQL Server)
OCR_DB_SERVER=
OCR_DB_NAME=FBR_OCR_GROUPED
OCR_DB_USER=
OCR_DB_PASSWORD=

# LLM (OpenAI-compatible API)
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL_NAME=deepseek-v4-pro

# Auth / sessions (use a long random value, at least 24 characters)
SESSION_SECRET=
HRMS_TOKEN_PASSPHRASE=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
COOKIE_SECURE=false
